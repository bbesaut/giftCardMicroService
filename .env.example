# Copy this file to .env and fill in real values. .env is gitignored - never commit real secrets.
# Load it into your PowerShell session with: .\scripts\load-env.ps1

# Brevo SMTP relay (Settings -> SMTP & API in the Brevo dashboard). MAIL_USERNAME/MAIL_PASSWORD
# are the SMTP login/key shown there, not your Brevo account password.
MAIL_USERNAME=
MAIL_PASSWORD=
# Must be a sender address verified in Brevo (Senders, Domains & Dedicated IPs -> Senders).
MAIL_FROM=
