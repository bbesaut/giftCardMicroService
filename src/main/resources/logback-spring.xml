<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- prod/test: unchanged, fully property-driven (logging.pattern.console/file, logging.level.*, logging.file.name) -->
    <springProfile name="!dev">
        <include resource="org/springframework/boot/logging/logback/base.xml"/>
    </springProfile>

    <!-- dev: colored console, with scheduler logs (com.finovago.p2p.scheduler) split into their own
         format - name in blue instead of buried among request logs, since they run outside any HTTP
         request/correlationId. -->
    <springProfile name="dev">
        <conversionRule conversionWord="levelClr" converterClass="com.finovago.p2p.logging.LevelColorConverter"/>
        <conversionRule conversionWord="clr" converterClass="org.springframework.boot.logging.logback.ColorConverter"/>

        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr([%thread]){faint} %levelClr(%-5level) %clr(%logger{36}){cyan} [correlationId=%X{correlationId}] - %msg%n</pattern>
            </encoder>
        </appender>

        <appender name="SCHEDULER_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr([%thread]){faint} %levelClr(%-5level) %clr(%logger{20}){blue}: %msg%n</pattern>
            </encoder>
        </appender>

        <logger name="com.finovago.p2p.scheduler" level="DEBUG" additivity="false">
            <appender-ref ref="SCHEDULER_CONSOLE"/>
        </logger>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
